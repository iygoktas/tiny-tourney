[gd_resource type="Theme" load_steps=17 format=3]

; Tiny Tourney's single UI theme. Bound once under
; Project Settings -> GUI -> Theme -> Custom, it restyles every screen at once,
; so no scene needs its own colours, font sizes or button styles.
;
; Palette (see DESIGN.md for the arena look this is aiming at):
;   ground    #17140F   very dark charcoal-brown
;   panel     #221D16   one step lighter, thin brass edge
;   ink       #E8E0D0   warm off-white, the main reading colour
;   ink dim   #A2957E   secondary text
;   brass     #B8863C   the accent: buttons, borders, highlights
;   gold      #D9A24E   brighter brass for hover and critical moments
;   blood     #8E2B22   health fill

[ext_resource type="FontFile" path="res://assets/fonts/AlegreyaSans-Regular.ttf" id="1_body"]
[ext_resource type="FontFile" path="res://assets/fonts/AlegreyaSans-Bold.ttf" id="2_body_bold"]
[ext_resource type="FontFile" path="res://assets/fonts/Cinzel.ttf" id="3_display"]

; Cinzel ships as a variable font, so the heavier cut used on buttons and
; headings is an instance of it rather than a separate file.
[sub_resource type="FontVariation" id="FontVariation_display_bold"]
base_font = ExtResource("3_display")
variation_opentype = {
"wght": 700
}

; ----- Buttons -------------------------------------------------------------
; The generous content margins are what stop buttons rendering as thin strips.

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_button_normal"]
content_margin_left = 22.0
content_margin_top = 12.0
content_margin_right = 22.0
content_margin_bottom = 12.0
bg_color = Color(0.169, 0.145, 0.11, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.451, 0.329, 0.153, 1)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_button_hover"]
content_margin_left = 22.0
content_margin_top = 12.0
content_margin_right = 22.0
content_margin_bottom = 12.0
bg_color = Color(0.239, 0.196, 0.129, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.722, 0.525, 0.235, 1)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

; Pressed sinks: darker fill, and the top border thickens like a pushed-in plate.
[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_button_pressed"]
