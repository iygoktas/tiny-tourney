; --- Label variations -------------------------------------------------------
; Everything reading at one size is what makes a screen look like a spreadsheet.
; Pick one of these per Label through Inspector -> Control -> Theme -> Type Variation.

; The one thing on the screen that should be read first: a character's name,
; a screen's title.
TitleLabel/base_type = &"Label"
TitleLabel/colors/font_color = Color(0.949, 0.898, 0.792, 1)
TitleLabel/font_sizes/font_size = 36
TitleLabel/fonts/font = SubResource("FontVariation_display_bold")

; Names a group of rows below it — "Stats", "Equipment", "Record".
SectionLabel/base_type = &"Label"
SectionLabel/colors/font_color = Color(0.722, 0.525, 0.235, 1)
SectionLabel/font_sizes/font_size = 16
SectionLabel/fonts/font = SubResource("FontVariation_display_bold")

; Detail that should stay legible without competing: battle counters, hints.
MutedLabel/base_type = &"Label"
MutedLabel/colors/font_color = Color(0.635, 0.584, 0.494, 1)
MutedLabel/font_sizes/font_size = 16

; A number worth noticing — a stat value, an XP total.
ValueLabel/base_type = &"Label"
ValueLabel/colors/font_color = Color(0.949, 0.898, 0.792, 1)
ValueLabel/font_sizes/font_size = 21
ValueLabel/fonts/font = ExtResource("2_body_bold")

; The one call to action per screen. Larger, and gold rather than parchment.
PrimaryButton/base_type = &"Button"
PrimaryButton/colors/font_color = Color(0.973, 0.898, 0.741, 1)
PrimaryButton/colors/font_hover_color = Color(1, 0.949, 0.851, 1)
PrimaryButton/font_sizes/font_size = 26
