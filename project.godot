; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Tiny Tourney"
run/main_scene="uid://bg3cra65jh3cg"
config/features=PackedStringArray("4.7", "C#", "Mobile")
config/icon="res://icon.svg"

[autoload]

GameState="*uid://c4njcjse5x7q1"
LocalizationManager="*uid://k0q2ljuq803o"
AudioSettingsManager="*uid://db42xq5iy7871"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="viewport"

[dotnet]

project/assembly_name="Tiny Tourney"

[environment]

defaults/default_clear_color=Color(0.09, 0.078, 0.063, 1)
renderer/rendering_method="mobile"

[gui]

theme/custom="res://assets/ui/tiny_tourney_theme.tres"

[internationalization]

